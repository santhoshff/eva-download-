# Optional: URL of an external self-hosted extractor microservice (e.g. your VPS running /extractor).
# Highly recommended for Vercel/Cloudflare deployments to bypass datacenter IP restrictions (HTTP 403).
# EVA_EXTRACTOR_URL="http://your-vps-ip:3000"

# Optional: Proof of Origin Token (PoToken) and visitor data for YouTube Innertube client.
# Helps avoid bot protection and IP blocks on direct Innertube streams.
# YOUTUBE_PO_TOKEN="your_po_token_here"
# YOUTUBE_VISITOR_DATA="your_visitor_data_here"
# POT_PROVIDER_URL="http://your-pot-provider:8080/token"

# Optional: Preferred YouTube Innertube client type ("ANDROID", "IOS", "WEB", "TV"). Default: ANDROID
# YOUTUBE_CLIENT_TYPE="ANDROID"

# Optional: API key for the AI smart renaming feature.
# If omitted, files are saved using their original title.
# LOVABLE_API_KEY="your-api-key-here"

