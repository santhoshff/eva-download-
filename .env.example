# Optional: URL of an external self-hosted extractor microservice.
# If omitted, the app uses its built-in local extractor and direct CDN streaming.
# EVA_EXTRACTOR_URL="https://your-extractor.domain.com"

# Optional: API key for the AI smart renaming feature.
# If omitted, files are saved using their original title.
# LOVABLE_API_KEY="your-api-key-here"
